{
  "name": "mindvault",
  "productName": "Mindvault",
  "version": "0.3.0",
  "description": "Local-first knowledge base: auto-organising inbox, knowledge graph, prompt toolbox and PDF reader.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Mindvault",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "cap:sync": "npm run build && cap sync android",
    "apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/qrcode": "^1.5.6",
    "@types/tesseract.js": "^0.0.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "app.mindvault.desktop",
    "productName": "Mindvault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
